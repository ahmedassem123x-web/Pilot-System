# Pilot System v3.1 — environment variable NAMES ONLY.
# NEVER put a value, token, password, or URL with credentials in this file
# or in any committed file. Copy this file to a local .env (git-ignored)
# and fill values there, per environment. See also
# .env.development.example and .env.production.example for the
# Development / Staging / Production separation note.
#
# Database (PostgreSQL 16; Sprint 1 owns the schema — Sprint 0 has no tables)
DATABASE_URL=
# Queue (Redis 7)
REDIS_URL=
# Auth (backend JWT signing; Sprint 3 owns auth — not used by Sprint 0)
JWT_SECRET=
# WhatsApp — direct Meta Cloud API (Sprint 2/3 own this — not used by Sprint 0)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=
# Files — short-lived signed links (Sprint 3)
FILE_LINK_SECRET=
# App
APP_BASE_URL=
NODE_ENV=
PORT=
# Compose-only placeholders (no values here either)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
REDIS_PORT=
FRONTEND_PORT=
