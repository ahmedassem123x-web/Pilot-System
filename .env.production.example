# Production environment — VARIABLE NAMES ONLY, no values.
# Development, Staging, and Production are SEPARATE environments: each gets
# its own .env file (never committed), its own database, and its own
# credentials. Production values are supplied only through the production
# host's secure environment handling, never in a file in this repository,
# never in chat, and never in a log. A Production .env file must never be
# copied from Development or Staging.
# Same variable names as .env.example; values are supplied at deploy time only.
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=
APP_BASE_URL=
NODE_ENV=
PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
REDIS_PORT=
FRONTEND_PORT=
