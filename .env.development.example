# Development environment — VARIABLE NAMES ONLY, no values.
# Development, Staging, and Production are SEPARATE environments: each gets
# its own .env file (never committed), its own database, and its own
# credentials. Nothing in this file is shared with Staging or Production,
# and no value from another environment is copied into Development.
# Same variable names as .env.example; values are supplied locally only.
DATABASE_URL=
REDIS_URL=
JWT_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=
APP_BASE_URL=
NODE_ENV=
PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
REDIS_PORT=
FRONTEND_PORT=
